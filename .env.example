# ShikshaSathi deployable-MVP Compose environment template
#
# Copy to `.env`, replace every CHANGE_ME/replace-me value, and keep the real
# file outside version control. Compose builds DATABASE_URL from POSTGRES_* and
# never stores a real credential in source.

APP_NAME=ShikshaSathi API
APP_ENV=production
APP_VERSION=0.9.0
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_ECHO=false
LOG_LEVEL=INFO

# Required: generate a unique random value of at least 32 characters.
# The committed placeholder is intentionally rejected at application startup.
SECRET_KEY=CHANGE_ME_generate_your_own_32_plus_char_random_secret_value

# Browser origin(s), including scheme. Production rejects an empty list or `*`.
CORS_ALLOWED_ORIGINS=["https://replace-me.example"]
# Host names only (no scheme/path). Include localhost for container probes.
TRUSTED_HOSTS=["replace-me.example","localhost","127.0.0.1"]
REQUEST_ID_HEADER=X-Request-ID

# The sixth login attempt from one client within 60 seconds is rejected.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

JWT_ALGORITHM=HS256
JWT_ISSUER=shikshasathi-v2
JWT_AUDIENCE=shikshasathi-v2-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_DOMAIN=

# Prefer the secure interactive bootstrap documented in README.md.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=

POSTGRES_DB=shikshasathi
POSTGRES_USER=shikshasathi
POSTGRES_PASSWORD=CHANGE_ME_use_a_unique_database_password

SHIKSHASATHI_IMAGE_TAG=phase9
SHIKSHASATHI_ENV_FILE=.env
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HOST_PORT=8080

# Recognition is inert until independently obtained, integrity-checked model
# artifacts are mounted through a deployment-specific Compose override.
FACE_RECOGNITION_PROVIDER=none
# FACE_DETECTION_MODEL_IDENTIFIER=yunet-2023mar
# FACE_EMBEDDING_MODEL_IDENTIFIER=dlib-resnet-v1
# FACE_DETECTOR_MODEL_PATH=/opt/shikshasathi/models/face_detection_yunet_2023mar.onnx
# FACE_DETECTOR_MODEL_SHA256=
# FACE_EMBEDDER_MODEL_PATH=/opt/shikshasathi/models/dlib_face_recognition_resnet_model_v1.dat
# FACE_EMBEDDER_MODEL_SHA256=
FACE_DETECTOR_INPUT_SIZE_PX=320
FACE_EMBEDDING_DIMENSION=128
# Provisional structural default, not classroom-calibrated accuracy.
FACE_MATCH_THRESHOLD=0.82
FACE_MATCH_AMBIGUOUS_MARGIN=0.05
FACE_INFERENCE_DEVICE=cpu
FACE_PROCESSING_BATCH_LIMIT=20
MAX_ENROLLMENT_IMAGE_BYTES=5242880
MAX_ENROLLMENT_IMAGE_PIXELS=30000000
MAX_ENROLLMENT_IMAGE_DIMENSION_PX=6000
MAX_BULK_ENROLLMENT_ZIP_BYTES=52428800
MAX_BULK_ENROLLMENT_FILES=200
MAX_BULK_ENROLLMENT_TOTAL_UNCOMPRESSED_BYTES=262144000
MAX_BULK_ENROLLMENT_COMPRESSION_RATIO=100.0
ENROLLMENT_STAGING_TIMEOUT_MINUTES=60

# Test profile only: isolated ephemeral PostgreSQL, never the production DB.
# POSTGRES_TEST_HOST_PORT=5433
# POSTGRES_TEST_DB=shikshasathi_test
# POSTGRES_TEST_USER=shikshasathi_test
# POSTGRES_TEST_PASSWORD=test_only_password_not_a_real_credential
# SECRET_KEY_TEST=test-only-secret-key-not-a-real-credential-0000000
