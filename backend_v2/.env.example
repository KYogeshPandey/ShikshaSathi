# ShikshaSathi backend_v2 — environment template (Rebuild Phase 1)
#
# Copy this file to `backend_v2/.env` for LOCAL, non-Docker development —
# e.g. running `uvicorn app.main:app` directly against a Postgres
# reachable at localhost (such as one started with
# `docker compose up postgres` from the repo root, which publishes
# Postgres on localhost:5432).
#
# For running the FULL stack via `docker compose up` at the repo root
# (backend_v2 + postgres together), use the ROOT-level `.env.example`
# instead: inside the Compose network, Postgres is reachable at the
# hostname `postgres`, not `localhost`, so docker-compose.yml builds
# backend_v2's DATABASE_URL itself from the root .env's POSTGRES_* values
# rather than reading this file directly. See backend_v2/README.md.
#
# NEVER commit a real `.env` file. Only this `.env.example` should be
# tracked. No value below is a real credential.

# --- Application metadata ---------------------------------------------------
APP_NAME=ShikshaSathi API
# development | testing | production
APP_ENV=development
APP_VERSION=0.1.0
# Must be false whenever APP_ENV=production (enforced at startup).
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ----------------------------------------------------------------
# Must use the asyncpg driver; SQLite is not supported (enforced at
# startup — see app/core/config.py). This example assumes a local
# Postgres reachable on localhost:5432 with a database/user/password
# matching the POSTGRES_* values below.
DATABASE_URL=postgresql+asyncpg://shikshasathi_dev:dev_only_password_change_me@localhost:5432/shikshasathi_dev
# Echoes every SQL statement to the log when true. Verbose; dev-only.
DATABASE_ECHO=false

# --- Logging -------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Security ------------------------------------------------------------------
# Required. No fallback default exists — startup fails loudly if this is
# unset, too short (<32 chars), or a known placeholder value. This is the
# direct structural fix for docs/AUDIT.md Critical finding C2 (the legacy
# app's insecure hardcoded fallback "change_this_in_env"). Generate a
# real value with e.g. `openssl rand -hex 32` — the value below is a
# placeholder and is NOT safe to actually use.
SECRET_KEY=CHANGE_ME_generate_your_own_32_plus_char_random_secret_value

# --- CORS ------------------------------------------------------------------------
# JSON array of allowed origins (preferred). A comma-separated value is also
# accepted by the settings parser. Must never be "*" in production
# (enforced at startup) — this is the direct fix for
# docs/AUDIT.md High finding H5 (the legacy app's `origins: "*"` on every
# /api/* route).
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Host names/IPs only (no scheme/path). Production rejects an empty list or `*`.
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Fixed-window login throttle. Multi-worker or horizontally scaled deployments
# must enforce a shared limit at the trusted ingress.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Request correlation -------------------------------------------------------
REQUEST_ID_HEADER=X-Request-ID

# --- Authentication (Phase 2) ------------------------------------------------------
# JWT access tokens are signed with SECRET_KEY above — no separate
# secret setting exists (docs/adr/0006-identity-and-auth-foundations.md).
JWT_ALGORITHM=HS256
JWT_ISSUER=shikshasathi-v2
JWT_AUDIENCE=shikshasathi-v2-clients
# Minutes; must be between 1 and 1440 (24h).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Days; must be between 1 and 90.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-token cookie. Must remain Secure=true whenever APP_ENV=production
# (enforced at startup) — relaxed to false below only for local
# http://localhost development.
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
# Leave unset for localhost development (no explicit cookie domain).
REFRESH_TOKEN_COOKIE_DOMAIN=

# --- Optional email OTP login (Milestone 4C) --------------------------------
# Disabled preserves the existing email/password -> JWT/refresh-session flow.
# Enabling requires an explicit provider. `development_log` is permitted only
# outside production and writes the OTP to controlled backend logs for manual
# local testing; it is rejected at production startup.
LOGIN_OTP_ENABLED=false
LOGIN_OTP_TTL_SECONDS=600
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
OTP_VERIFY_RATE_LIMIT_ATTEMPTS=10
OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=300
OTP_RESEND_RATE_LIMIT_ATTEMPTS=5
OTP_RESEND_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_RESET_GRANT_TTL_SECONDS=300
PASSWORD_RESET_REQUEST_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_RESET_CONFIRM_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=300
OTP_EMAIL_PROVIDER=none
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT_SECONDS=10

# --- Admin bootstrap (Phase 2, optional) --------------------------------------------
# Consumed ONLY by scripts/bootstrap_admin.py — the running API never
# reads these. Leave both unset to be prompted interactively instead
# (recommended for a real deployment; the password is never echoed or
# logged). NEVER put a real password in a committed file.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional deterministic demo seed (operator-invoked only) ----------------
# `python -m scripts.seed_demo_data` reads the password without echo when this
# is unset. Never commit a real password. The `.example` identities are safe
# defaults; override only accounts that need to receive a real OTP.
# DEMO_SEED_PASSWORD=
DEMO_SEED_ALLOW_PRODUCTION=false
DEMO_ADMIN_EMAIL=admin@demo.shikshasathi.example
DEMO_TEACHER_ONE_EMAIL=teacher.one@demo.shikshasathi.example
DEMO_TEACHER_TWO_EMAIL=teacher.two@demo.shikshasathi.example
DEMO_STUDENT_ONE_EMAIL=student.01@demo.shikshasathi.example

# --- Postgres --------------------------------------------------------------------
# Also consumed directly by the `postgres` Compose service; see the
# root .env.example when running the full stack via `docker compose up`.
POSTGRES_DB=shikshasathi_dev
POSTGRES_USER=shikshasathi_dev
POSTGRES_PASSWORD=dev_only_password_change_me

# --- Face recognition (Phase 5, optional runtime activation) -----------------------
# Detection, embedding, matching, enrollment, and recognition-attendance are
# implemented. Every value below is safe to leave at its default;
# the feature stays inert until FACE_RECOGNITION_PROVIDER is explicitly
# set to something other than "none", which then requires both model
# identifiers below (enforced at startup — see app/core/config.py).
# FACE_RECOGNITION_PROVIDER=none
# FACE_DETECTION_MODEL_IDENTIFIER=
# FACE_EMBEDDING_MODEL_IDENTIFIER=
# FACE_DETECTOR_INPUT_SIZE_PX=320
# FACE_EMBEDDING_DIMENSION=128
# Cosine-similarity semantics only (higher = more similar).
# FACE_MATCH_THRESHOLD=0.82
# FACE_MATCH_AMBIGUOUS_MARGIN=0.05
# FACE_INFERENCE_DEVICE=cpu
# MAX_ATTENDANCE_IMAGE_BYTES=8388608
# MAX_ATTENDANCE_FACES_PER_IMAGE=40
# Must resolve outside any public/static web directory (validated at
# startup) — see docs/BIOMETRIC_DATA_POLICY.md.
# BIOMETRIC_STORAGE_ROOT=var/biometric_data
# MAX_ENROLLMENT_IMAGE_BYTES=5242880

# --- Face recognition (Phase 5 Stage 2, optional) -----------------------------------
# Enrollment/ingestion bounds only — still provider-neutral, still no
# detector/embedder model loaded or downloaded. See
# app/modules/biometric_enrollment/ and docs/BIOMETRIC_DATA_POLICY.md.
# MAX_ENROLLMENT_IMAGE_PIXELS=30000000
# MAX_ENROLLMENT_IMAGE_DIMENSION_PX=6000
# MAX_BULK_ENROLLMENT_ZIP_BYTES=52428800
# MAX_BULK_ENROLLMENT_FILES=200
# MAX_BULK_ENROLLMENT_TOTAL_UNCOMPRESSED_BYTES=262144000
# MAX_BULK_ENROLLMENT_COMPRESSION_RATIO=100.0
# ENROLLMENT_STAGING_TIMEOUT_MINUTES=60

# --- Face recognition (Phase 5 Stage 3, optional) -----------------------------------
# Real detection/alignment/embedding/matching. Setting
# FACE_RECOGNITION_PROVIDER=server_side_local (above) now requires all
# four of FACE_DETECTION_MODEL_IDENTIFIER, FACE_EMBEDDING_MODEL_IDENTIFIER
# (both above), FACE_DETECTOR_MODEL_PATH, and FACE_EMBEDDER_MODEL_PATH
# below — the app fails fast at startup otherwise. See
# app/modules/face_recognition/ and docs/HANDOVER_PHASE_5_STAGE_3.md.
#
# Neither model file is downloaded, vendored, or committed by this
# application or included in any ZIP built from this repository — a
# deployer obtains both independently and places them at these paths.
# Placeholder paths/checksums only; a real .env must point at real files.
#
# Detector: YuNet face detection ONNX model (OpenCV Zoo).
# FACE_DETECTOR_MODEL_PATH=/etc/shikshasathi/models/face_detection_yunet_2023mar.onnx
# FACE_DETECTOR_MODEL_SHA256=
#
# Embedder: dlib_face_recognition_resnet_model_v1 (public domain — see
# docs/HANDOVER_PHASE_5_STAGE_3.md for exact source/version/license).
# FACE_EMBEDDER_MODEL_PATH=/etc/shikshasathi/models/dlib_face_recognition_resnet_model_v1.dat
# FACE_EMBEDDER_MODEL_SHA256=
#
# Bounded, on-demand batch size for
# SampleProcessingService.process_pending_batch(...) — never an
# always-running worker.
# FACE_PROCESSING_BATCH_LIMIT=20
