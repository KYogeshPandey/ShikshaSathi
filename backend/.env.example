# ShikshaSathi backend — environment template
# Copy to `.env` in the `backend/` folder and fill in real values.
# NEVER commit the real `.env` file. Only this `.env.example` should be tracked.
#
# NOTE (Rebuild Phase 0 audit): as of this audit, the running Flask app only
# actually reads TWO variables from the environment — MONGODB_URI and
# JWT_SECRET (see backend/app/core/db.py and backend/app/__init__.py).
# Everything else below is currently hardcoded in source rather than
# configurable, and is listed here as a RESERVED placeholder for the
# variable it should become once wired up (legacy hardening or v2 rebuild).
# See docs/AUDIT.md for the exact findings behind each group.

# -------------------------------------------------------------------
# Flask application
# -------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# -------------------------------------------------------------------
# MongoDB  (ACTIVELY USED — backend/app/core/db.py)
# -------------------------------------------------------------------
# Full connection string, including credentials. Get this from your
# MongoDB Atlas cluster (or local mongod). Never share this value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=shiksha_sathi

# -------------------------------------------------------------------
# JWT / security  (ACTIVELY USED — backend/app/__init__.py)
# -------------------------------------------------------------------
# Required. The current source falls back to the literal string
# "change_this_in_env" if this is unset — that fallback is a Critical
# finding in docs/AUDIT.md and must never be relied on outside a local
# throwaway environment.
JWT_SECRET=replace_with_a_long_random_value

# RESERVED — not yet read by any code. Access tokens currently use the
# flask-jwt-extended library default expiry with no refresh flow.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# -------------------------------------------------------------------
# CORS  (RESERVED — currently hardcoded to origins: "*" in app/__init__.py)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------------------
# Rate limiting  (RESERVED — flask-limiter is a declared dependency but
# is never instantiated anywhere in the current codebase; no endpoint,
# including /auth/login, is currently rate limited)
# -------------------------------------------------------------------
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN_PER_MINUTE=5

# -------------------------------------------------------------------
# File uploads  (RESERVED — no size/type limits are currently
# configurable; backend/app/utils/file_upload.py hardcodes allowed
# image extensions and has no explicit size cap)
# -------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png

# -------------------------------------------------------------------
# Face recognition  (RESERVED — backend/app/ml/{detector,embedder,matcher}.py
# are present but empty; opencv-python and mtcnn are declared dependencies
# with no current usage anywhere in the codebase)
# -------------------------------------------------------------------
FACE_MATCH_THRESHOLD=0.6
FACE_STORAGE_DIR=backend/app/static/faces

# -------------------------------------------------------------------
# Frontend API base URL  (ACTIVELY USED — frontend/src/api/api.js,
# read at build time by Create React App as REACT_APP_API_URL)
# -------------------------------------------------------------------
REACT_APP_API_URL=http://localhost:5000
